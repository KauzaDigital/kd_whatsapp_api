KD_API_KEY=kd_api_key
KD_WEBHOOK_SECRET=replace-with-another-random-secret
EVOLUTION_API_KEY=replace-with-another-random-secret
EVOLUTION_INSTANCE=kd_whatsapp_local
# Use a hex password to avoid special characters in the PostgreSQL URI.
POSTGRES_PASSWORD=replace-with-random-hex-password
# Optional image override; keep a tested version or digest.
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
# For running directly on Windows instead of Compose:
# PORT=3000
# EVOLUTION_URL=http://localhost:8080
# KD_WEBHOOK_URL=http://host.docker.internal:3000/api/v1/webhooks/evolution
